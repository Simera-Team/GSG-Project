DATABASE_URL=postgresql+psycopg://simera:YOUR_PASSWORD@localhost:5432/simera_db
JWT_SECRET_KEY=YOUR_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# --- LLM field extraction (only GEMINI_API_KEY is required) ---
# Free key: https://aistudio.google.com -> Get API key
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-4-hydrogen
LLM_TIMEOUT_SECONDS=120
LLM_THINKING_LEVEL=medium
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=2

# Fields below this confidence go to human review (FR-046)
REVIEW_CONFIDENCE_THRESHOLD=0.6

# Process uploads automatically after the response (until the RabbitMQ worker exists)
PROCESS_UPLOADS_AUTOMATICALLY=true

# OCR threads (4 is fastest on laptops with performance + efficiency cores)
OCR_THREADS=4
